{
  "$description": "Master copy of every color in Bodai Word Ladder. Edit here, then run `npm run tokens` to rebuild src/styles/tokens.css. Values come from Bodai Sudoku so both games feel like one family.",
  "theme": {
    "$description": "Colors that change with light and dark mode, the same for every palette.",
    "light": {
      "bg": "#f1ecdf",
      "surface": "#ffffff",
      "ink": "#10303b",
      "muted": "#55666d",
      "edge": "#10303b2e",
      "tile": "#d9e0dd",
      "tile-ink": "#10303b",
      "accent-ink": "#10303b",
      "match": "#3ecf8e",
      "match-ink": "#0b2a33",
      "near": "#ffd27a",
      "near-ink": "#10303b",
      "bad": "#ffdcd5",
      "bad-ink": "#b3261e",
      "toast": "#10303b",
      "toast-ink": "#ffffff",
      "scrim": "#f1ecdfb8",
      "glasses": "#2c3f8f",
      "blush": "#f4a6b4",
      "fur": "#eeff41",
      "fur-shade": "#c9da1e",
      "tongue": "#f08a8d",
      "collar": "#e5484d"
    },
    "dark": {
      "bg": "#0a1e25",
      "surface": "#123039",
      "ink": "#eaf2f0",
      "muted": "#9db2b5",
      "edge": "#00000059",
      "tile": "#1b3f49",
      "tile-ink": "#eaf2f0",
      "accent-ink": "#0a1e25",
      "match": "#24855b",
      "match-ink": "#eafff4",
      "near": "#6b4a12",
      "near-ink": "#ffe2b0",
      "bad": "#5c2420",
      "bad-ink": "#ffb4a8",
      "toast": "#eaf2f0",
      "toast-ink": "#0a1e25",
      "scrim": "#0a1e25bd",
      "glasses": "#8ea2ff",
      "blush": "#f4a6b4",
      "fur": "#eeff41",
      "fur-shade": "#c9da1e",
      "tongue": "#f08a8d",
      "collar": "#e5484d"
    }
  },
  "palettes": {
    "$description": "The player's chosen color family. Each palette has a light and a dark version.",
    "bodai": {
      "light": {
        "accent": "#eeff41",
        "highlight": "#f3faae",
        "highlight-strong": "#e6f08a",
        "highlight-ink": "#10303b",
        "highlight-faint": "#fbfde4"
      },
      "dark": {
        "accent": "#eeff41",
        "highlight": "#3b4612",
        "highlight-strong": "#4a5719",
        "highlight-ink": "#f2ffb0",
        "highlight-faint": "#4a5222"
      }
    },
    "berry": {
      "light": {
        "accent": "#ff9fd2",
        "highlight": "#ffe0f1",
        "highlight-strong": "#ffc6e5",
        "highlight-ink": "#10303b",
        "highlight-faint": "#fff1f8"
      },
      "dark": {
        "accent": "#ff9fd2",
        "highlight": "#4a1835",
        "highlight-strong": "#5c2043",
        "highlight-ink": "#ffd3ea",
        "highlight-faint": "#4f2440"
      }
    },
    "lavender": {
      "light": {
        "accent": "#c9b6ff",
        "highlight": "#ece5ff",
        "highlight-strong": "#dccfff",
        "highlight-ink": "#10303b",
        "highlight-faint": "#f6f2ff"
      },
      "dark": {
        "accent": "#c9b6ff",
        "highlight": "#2e2350",
        "highlight-strong": "#3a2d63",
        "highlight-ink": "#e2d9ff",
        "highlight-faint": "#34295a"
      }
    },
    "mango": {
      "light": {
        "accent": "#ffb547",
        "highlight": "#ffe9c4",
        "highlight-strong": "#ffd894",
        "highlight-ink": "#10303b",
        "highlight-faint": "#fff6e6"
      },
      "dark": {
        "accent": "#ffb547",
        "highlight": "#4a3410",
        "highlight-strong": "#5c4116",
        "highlight-ink": "#ffe2b0",
        "highlight-faint": "#4f3a1c"
      }
    },
    "ocean": {
      "light": {
        "accent": "#6ee7e0",
        "highlight": "#d3f6f4",
        "highlight-strong": "#aeeeea",
        "highlight-ink": "#10303b",
        "highlight-faint": "#ecfbfa"
      },
      "dark": {
        "accent": "#6ee7e0",
        "highlight": "#0f3f45",
        "highlight-strong": "#155159",
        "highlight-ink": "#c8fbf8",
        "highlight-faint": "#1d4a4f"
      }
    }
  },
  "shape": {
    "$description": "Corner radius in px.",
    "corner-sm": 8,
    "corner-md": 12,
    "corner-lg": 16,
    "corner-pill": 999
  },
  "space": {
    "$description": "Spacing in px, as CSS variables (--space-md). They match Tailwind's 4px scale: xs = 1, sm = 2, md = 3, lg = 4, xl = 6, 2xl = 8, 3xl = 12.",
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "gutter": 16,
    "column": 448
  },
  "type": {
    "$description": "Outfit everywhere, like Boduku. Each style: size and line height in px, weight, letter spacing in em.",
    "family": "Outfit",
    "styles": {
      "display": {
        "size": 40,
        "line": 44,
        "weight": 800,
        "tracking": -0.01,
        "use": "Game title and big win moments"
      },
      "title": {
        "size": 28,
        "line": 32,
        "weight": 800,
        "tracking": -0.01,
        "use": "Screen titles, today's date on the daily card"
      },
      "heading": {
        "size": 20,
        "line": 26,
        "weight": 700,
        "tracking": 0,
        "use": "Card and sheet headings"
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400,
        "tracking": 0,
        "use": "Everything you read"
      },
      "body-strong": {
        "size": 16,
        "line": 24,
        "weight": 600,
        "tracking": 0,
        "use": "Buttons and emphasis"
      },
      "small": {
        "size": 14,
        "line": 20,
        "weight": 400,
        "tracking": 0,
        "use": "Help text and meanings"
      },
      "label": {
        "size": 12,
        "line": 16,
        "weight": 700,
        "tracking": 0.08,
        "case": "upper",
        "use": "Section labels like TODAY'S PUZZLE and LEVELS"
      },
      "tile": {
        "size": 24,
        "line": 24,
        "weight": 800,
        "tracking": 0,
        "case": "upper",
        "use": "Letters on the ladder"
      },
      "key": {
        "size": 18,
        "line": 20,
        "weight": 700,
        "tracking": 0,
        "case": "upper",
        "use": "Keyboard letters"
      }
    }
  },
  "elevation": {
    "$description": "Shadows. Soft, like Boduku's cards.",
    "shadow-card": "0 1px 0 #10303b14, 0 8px 20px -12px #10303b40",
    "shadow-raised": "0 2px 0 #10303b14, 0 16px 32px -16px #10303b59",
    "shadow-pressed": "inset 0 2px 0 #10303b1f"
  },
  "motion": {
    "$description": "Durations in ms and easing curves. Everything respects reduced motion: movement stops, color changes stay.",
    "duration-instant": 80,
    "duration-fast": 140,
    "duration-base": 220,
    "duration-slow": 360,
    "duration-celebrate": 900,
    "ease-standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "feedback": {
    "$description": "What the player hears and feels for each moment. Sounds are soft synthesized tones (like Boduku) or recordings; haptics only run in the phone app. Every sound respects the Sound setting, every buzz the Vibration setting.",
    "events": {
      "key-tap": {
        "sound": null,
        "haptic": "tap",
        "note": "Silent on purpose: typing should feel light."
      },
      "letter-picked": {
        "sound": {
          "tone": [520],
          "length": 0.06,
          "volume": 0.03
        },
        "haptic": "tap",
        "note": "Choosing which letter to change."
      },
      "rung-added": {
        "sound": {
          "tone": [587, 784],
          "length": 0.09,
          "volume": 0.05
        },
        "haptic": "tap",
        "note": "A real word, one rung up. Two rising notes."
      },
      "not-a-word": {
        "sound": {
          "samples": ["frisky-bark"],
          "volume": 0.45
        },
        "haptic": "error",
        "note": "Rung shakes, one bone eaten: a quiet bark as it drops into Frisky's mouth."
      },
      "keep-it-friendly": {
        "sound": null,
        "haptic": null,
        "note": "A blocked word: gentle toast, no sound, no buzz, no bone lost."
      },
      "hint": {
        "sound": {
          "tone": [880],
          "length": 0.08,
          "volume": 0.04
        },
        "haptic": "tap",
        "note": "A hint appears."
      },
      "undo": {
        "sound": {
          "tone": [440],
          "length": 0.05,
          "volume": 0.03
        },
        "haptic": null,
        "note": "Stepping back down."
      },
      "solved": {
        "sound": {
          "samples": ["laugh"]
        },
        "haptic": "win",
        "note": "One laugh, from the family's twelve and three recorded ones, shuffled so the same one doesn't repeat soon, like Boduku."
      },
      "under-par": {
        "sound": {
          "samples": ["frisky-bark", "laugh"]
        },
        "haptic": "win",
        "note": "Frisky barks, then a laugh, like Boduku's happiest moments."
      },
      "sound-on": {
        "sound": {
          "tone": [520],
          "length": 0.09,
          "volume": 0.04
        },
        "haptic": null,
        "note": "The tick when Sound is switched on, so you know it works."
      }
    },
    "haptics": {
      "tap": "Light impact",
      "error": "Error notification",
      "win": "Success notification"
    }
  }
}
