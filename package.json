{
  "name": "bodai-word-ladder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "words": "node scripts/build-words.ts",
    "tokens": "node scripts/build-tokens.ts",
    "figma-sync": "node scripts/build-figma-sync.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "daily": "node scripts/build-daily.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "naughty-words": "^1.2.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wordlist-english": "^1.2.1",
    "wordnet-db": "^3.1.14",
    "storybook": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8"
  },
  "engines": {
    "node": ">=22"
  }
}
